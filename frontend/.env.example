# Copy to .env.local and adjust.

# T11's read API. The backend runs on 8001, not FastAPI's default 8000 (see TASKS.md).
VITE_API_BASE_URL=http://localhost:8001

# MSW mocks the T11 API in dev until it ships (src/mocks). Set to false once the backend
# is live and you want `npm run dev` to hit it for real.
VITE_ENABLE_MOCKS=true
