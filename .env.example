# Copy to .env and adjust. `.env` is gitignored and always has been -- it is never committed.
#
# This one file feeds two different consumers, which is worth understanding before editing it:
#
#   1. **Compose substitution.** `docker compose` reads ./.env from the directory it runs in
#      and substitutes `${VAR}` references in compose.yaml / compose.prod.yaml. The services
#      declare `environment:` and no `env_file:`, so a variable reaches a container only if
#      some compose file mentions it by name. Adding a key here that no compose file
#      references does nothing.
#   2. **A backend run natively on the host** (`cd backend && uv run uvicorn ...`), where
#      app/config.py reads a `.env` relative to the working directory. That is `backend/.env`,
#      a separate file -- not this one.
#
# Inside Docker, DATABASE_URL and DATA_DIR are always set by compose and whatever is written
# here for them is ignored. They matter only for case 2.


# ---------------------------------------------------------------------------------------
# Database credentials
# ---------------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. compose.prod.yaml declares all three as `${VAR:?...}`, so
# `docker compose -f compose.yaml -f compose.prod.yaml up` aborts before starting anything and
# names the missing variable. Dev defaults them to gex/gex/gex, so a plain `docker compose up`
# on a laptop still works with this file absent entirely.
#
# Both the postgres service and the backend's DATABASE_URL are assembled from these three, so
# they have exactly one source and cannot disagree.
#
# POSTGRES_PASSWORD ends up inside a URL. Pick a password with no @ : / ? # in it, or
# percent-encode those characters, otherwise the connection string parses wrong.
#
# It also only ever applies at *first* init of an empty data directory. Changing it here does
# not change the password of a database that already exists -- see the README's "Rotating the
# database password" for the ALTER USER that does.
POSTGRES_USER=gex
POSTGRES_PASSWORD=
POSTGRES_DB=gex


# ---------------------------------------------------------------------------------------
# Application settings (optional -- every one has a working default)
# ---------------------------------------------------------------------------------------
# Option chain source. `cboe` is free and keyless and is what the app is built around.
PROVIDER=cboe
# The five option underlyings the 16:20 ET EOD capture covers. Not the scan universe -- that
# is SCAN_UNIVERSE in app/config.py, which is far wider and drives daily bars.
SYMBOLS=SPX,SPY,QQQ,GLD,DIA
# Market time, and deliberate: the scheduler's cron triggers and the trading-calendar holiday
# checks both read this. A host left on UTC fires every job at the wrong wall-clock hour while
# looking perfectly healthy. Postgres runs UTC separately -- that is set in compose.yaml and
# is not this value.
TZ=America/New_York

# T32 retention: days of per-strike detail kept for intraday (non-EOD) snapshots. EOD strike
# detail, every gex_levels summary row and every Parquet file are kept forever regardless.
# 0 disables pruning. Pruned days are rebuildable from Parquet via `python -m app.gex.backfill`.
INTRADAY_STRIKE_RETENTION_DAYS=30

# T18 15-minute intraday polling, 09:45-16:15 NY. OFF by default: the scheduler only fires
# while the process is alive and an intraday slot has no recovery path, so leaving this on for
# a laptop that is open half the time builds a series with invisible gaps. On an always-on
# homeserver that reasoning no longer applies -- this is the flag to turn on there.
INTRADAY_ENABLED=false

# T74 intraday bars: 5-minute buckets for INTRADAY_BARS_SYMBOLS, polled 09:30-16:05 NY.
# Separate from INTRADAY_ENABLED on purpose -- that polls Cboe for option chains, this polls
# Yahoo for bars, and one being throttled must not force the other off.
INTRADAY_BARS_ENABLED=false


# ---------------------------------------------------------------------------------------
# Host-native runs only (ignored inside Docker)
# ---------------------------------------------------------------------------------------
# Compose overrides both of these: DATABASE_URL is assembled from the POSTGRES_* values above
# and points at the `postgres` service, and DATA_DIR is the /data bind mount.
DATABASE_URL=postgresql+psycopg://gex:gex@localhost:5432/gex
DATA_DIR=./data
# Continuous dividend yield used to build the option forward for the Greeks.
DIVIDEND_YIELD=0.013
# Only needed if PROVIDER=marketdata. Get a free token at https://www.marketdata.app/.
MARKETDATA_TOKEN=
# Annualized, continuously compounded. A parameter, never fetched from a rates feed.
RISK_FREE_RATE=0.04
