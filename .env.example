# Copy to .env and adjust. Values here are for running the backend directly
# on the host (uv run ...). Inside docker-compose, DATABASE_URL and DATA_DIR
# are overridden in docker-compose.yml (postgres host, /data mount).

DATABASE_URL=postgresql+psycopg://gex:gex@localhost:5432/gex
DATA_DIR=./data
PROVIDER=cboe
# Only needed if PROVIDER=marketdata. Get a free token at https://www.marketdata.app/.
MARKETDATA_TOKEN=
SYMBOLS=SPX,SPY,QQQ
TZ=America/New_York
